# Copy to ".env" and fill in real values. Never commit the real .env.

ENVIRONMENT=development

# Leave blank for local SQLite (storage/copytrade.db, created automatically).
DATABASE_PATH=
DATABASE_URL=

# Generate with: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Telegram (Ab Marshall channel)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=copytrade_session
AB_MARSHALL_CHANNEL=marshallfx_free_channel
ADMIN_TELEGRAM_USERNAME=

# MT5 (per-machine terminal path; each customer's own login/password/server
# is entered through the web app and stored encrypted in the database)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Safety - keep true until RealMT5Executor has been verified on your machine
DRY_RUN=true
DUPLICATE_WINDOW_SECONDS=30

CHALLENGE_DURATION_DAYS=30
CHALLENGE_PRICE=
PAY_TELEBIRR_INSTRUCTIONS=
PAY_CBE_INSTRUCTIONS=

HTTP_HOST=127.0.0.1
HTTP_PORT=8000
